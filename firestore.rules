rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: contents
    // Document ID: konten-{no} or custom ID
    // Fields:
    //   - no: int (required) - Sequence number
    //   - judul: string (required, <= 500 chars) - Title
    //   - kategori: string (required, <= 100 chars) - Category
    //   - copywriting: string (required, <= 10000 chars) - Copy text
    //   - ambience: string (required, <= 5000 chars) - Ambience / visual direction
    //   - caption: string (required, <= 10000 chars) - Post caption
    //   - executed: bool (required) - Execution status
    //   - priority: bool (optional) - Priority flag
    //   - platform: string (optional, <= 100 chars) - Target platform
    //   - targetDate: string (optional, <= 100 chars) - Target publish date
    //   - notes: string (optional, <= 5000 chars) - Additional notes
    //   - createdAt: string (optional, <= 100 chars) - Creation timestamp
    //   - updatedAt: string (optional, <= 100 chars) - Last updated timestamp
    //   - id: string (optional, <= 100 chars) - Document ID
    //
    // Collection: stok
    // Document ID: stokId (e.g., 'ringkasan' or item ID)
    // Description: Handphone inventory stock data & summary doc 'ringkasan'.
    // Permissions: Public read; client writes disabled (managed via server / Admin SDK).
    //
    // Collection: lajul
    // Document ID: lajulId (e.g., 'ringkasan' or report ID)
    // Description: Sales report data (Laporan Penjualan) & summary doc 'ringkasan'.
    // Permissions: Public read; client writes disabled (managed via server / Admin SDK).
    //
    // Collection: security
    // Document ID: store_network
    // Description: Store Wi-Fi public IP synchronization & network security configuration.
    // Fields:
    //   - current_ip: string (required, 7-45 chars) - Store public IP (IPv4 or IPv6)
    //   - updated_at: string (required, <= 100 chars) - ISO 8601 update timestamp
    //   - store: string (required, <= 100 chars) - Store name/identifier
    //   - sync_secret: string (optional, <= 100 chars) - Optional synchronization secret
    // Permissions: Public read; validate schema on create/update; client delete disabled.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions & Domain Validators
    // ===============================================================

    function isValidContent(data) {
      return data.keys().hasAll(['no', 'judul', 'kategori', 'copywriting', 'ambience', 'caption', 'executed'])
        && data.no is int
        && data.judul is string && data.judul.size() <= 500
        && data.kategori is string && data.kategori.size() <= 100
        && data.copywriting is string && data.copywriting.size() <= 10000
        && data.ambience is string && data.ambience.size() <= 5000
        && data.caption is string && data.caption.size() <= 10000
        && data.executed is bool
        && (!('priority' in data) || data.priority is bool)
        && (!('platform' in data) || (data.platform is string && data.platform.size() <= 100))
        && (!('targetDate' in data) || (data.targetDate is string && data.targetDate.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100))
        && (!('id' in data) || (data.id is string && data.id.size() <= 100));
    }

    function isValidStoreNetwork(data) {
      return data.keys().hasAll(['current_ip', 'updated_at', 'store'])
        && data.keys().hasOnly(['current_ip', 'updated_at', 'store', 'sync_secret'])
        && data.current_ip is string && data.current_ip.size() >= 7 && data.current_ip.size() <= 45
        && data.updated_at is string && data.updated_at.size() <= 100
        && data.store is string && data.store.size() <= 100
        && (!('sync_secret' in data) || (data.sync_secret is string && data.sync_secret.size() <= 100));
    }

    // Koleksi contents: Semarang Cell Instagram Content Hub
    match /contents/{contentId} {
      allow read: if true;
      allow create, update: if isValidContent(request.resource.data);
      allow delete: if true;
    }

    // Koleksi stok: Stok handphone & dokumen ringkasan
    // Read: Publik untuk kebutuhan display katalog / ketersediaan toko
    // Write: Hanya melalui backend / Admin SDK (ditolak untuk client SDK langsung)
    match /stok/{stokId} {
      allow read: if true;
      allow write: if false;
    }

    // Koleksi lajul: Laporan penjualan & dokumen ringkasan
    // Read: Publik untuk kebutuhan visualisasi report toko
    // Write: Hanya melalui backend / Admin SDK (ditolak untuk client SDK langsung)
    match /lajul/{lajulId} {
      allow read: if true;
      allow write: if false;
    }

    // Koleksi security: Pengaturan keamanan dan sinkronisasi jaringan toko
    match /security/store_network {
      allow read: if true;
      allow create, update: if isValidStoreNetwork(request.resource.data);
      allow delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
